# Copy to .env at the repository root. Do not commit secrets.
# Application
AEGIS_ENV=development
AEGIS_DEBUG=false
AEGIS_APP_NAME=aegis
AEGIS_LOG_LEVEL=INFO

# Database (NFR-060, ADR-002)
# Use the asyncpg driver prefix. Local defaults match docker/docker-compose.yml.
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis@127.0.0.1:5434/aegis

# Redis (not used yet)
REDIS_URL=

# AWS
AWS_REGION=

# Amazon Bedrock
BEDROCK_MODEL_ID=

# Authentication
JWT_SECRET=

# GitHub
GITHUB_TOKEN=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=

# Other secrets
SECRET_KEY=
