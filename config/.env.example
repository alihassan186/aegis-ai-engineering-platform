# AEGIS environment configuration examples
# Copy this file to the repository root as .env. Do not commit secrets.
AEGIS_ENV=development
AEGIS_DEBUG=false
AEGIS_APP_NAME=aegis
AEGIS_LOG_LEVEL=INFO

# PostgreSQL (matches docker/docker-compose.yml local defaults)
# Driver prefix postgresql+asyncpg:// is required by ADR-002.
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis@127.0.0.1:5434/aegis

# JWT signing secret (THR-013). Required in production. Never commit real secrets.
# Local only: POST /api/v1/auth/token issues a token. Production uses an IdP.
AEGIS_JWT_SECRET=change-me-to-a-long-random-string
AEGIS_JWT_EXPIRE_SECONDS=3600

# Webhook HMAC (THR-002). Required in production. Same value as SIMULATOR_WEBHOOK_SECRET.
# Never commit real secrets. IP allowlisting is a follow-up.
AEGIS_WEBHOOK_SECRET=change-me-to-a-long-random-webhook-secret

# Production simulator (apps/simulator, Step 2.5+).
SIMULATOR_ENV=development
SIMULATOR_APP_NAME=simulator
SIMULATOR_HOST=127.0.0.1
SIMULATOR_PORT=8001
AEGIS_BASE_URL=http://127.0.0.1:8000
SIMULATOR_WEBHOOK_SECRET=change-me-to-a-long-random-webhook-secret
# Optional: one FR-083 scenario at boot (empty = none). Also POST /scenarios/{id}.
# SIMULATOR_SCENARIO=latency_spike

# OpenSearch (Step 3.1). Empty = RAG store unset; tests skip the cluster ping.
# No password in local compose (security plugin disabled). Production is Phase 6.
AEGIS_OPENSEARCH_URL=http://127.0.0.1:9200
