# Local PostgreSQL credentials for docker/docker-compose.yml
# Copy to docker/.env — never commit docker/.env
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis

# Host port (5432/5433 are often already used by other local Postgres containers)
POSTGRES_HOST_PORT=5434

# pgAdmin UI (5050 is often used by other local pgAdmin containers)
PGADMIN_HOST_PORT=5051
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
